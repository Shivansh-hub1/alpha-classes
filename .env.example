# ---- Database (Neon) ----
# Paste your Neon connection string (Neon dashboard -> Connect -> Connection string)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- Auth (required in production) ----
# Any long random string. Generate one: https://generate-secret.vercel.app/  (or run:  openssl rand -hex 32)
AUTH_SECRET=change-me-to-a-long-random-string

# ---- Admin panel password ----
ADMIN_PASSWORD=change-me-admin-password

# ---- Site URL (used for SEO: sitemap, canonical, OpenGraph) ----
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---- Optional: demo video (YouTube video ID shown in the hero popup) ----
# NEXT_PUBLIC_DEMO_VIDEO_ID=dQw4w9WgXcQ
